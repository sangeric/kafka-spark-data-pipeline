# Copier ce fichier en ".env" puis remplir les valeurs vides.
# Le fichier .env est ignoré par Git : il ne doit JAMAIS être commité.
#
# Générer une valeur aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Versions des images ---
SPARK_VERSION=4.0.0
AIRFLOW_VERSION=3.3.1
POSTGRES_VERSION=16

# --- Ressources des workers Spark ---
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# --- Ports publiés sur ta machine (127.0.0.1) ---
SPARK_UI_PORT=8081
AIRFLOW_UI_PORT=8082

# --- Base de métadonnées Airflow ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# --- Airflow ---
# Secret partagé entre l'api-server et le scheduler pour signer les jetons des tâches
AIRFLOW_JWT_SECRET=
# Nom de l'utilisateur de l'interface ; son mot de passe est dans
# secrets/simple_auth_manager_passwords.json (voir le fichier .example à côté)
AIRFLOW_ADMIN_USER=admin
